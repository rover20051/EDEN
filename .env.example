# Copiar a .env.local y completar con los datos del proyecto de Supabase (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cambia cuando compren el dominio. Todo lo que arma links (mails, pagos) sale de acá.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave secreta de Supabase (Settings > API > Secret keys). Solo servidor: checkout, seguimiento y pagos.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Pago con tarjeta.
# - NAVE_CLIENT_ID: credenciales de Nave (la integración real todavía no está hecha; con esto cargado la tarjeta sigue "Muy pronto").
# - PAGOS_PRUEBA=1: formulario de tarjeta simulado que no cobra nada, para probar la compra de punta a punta.
#   Tarjetas: 4242 4242 4242 4242 (aprobada) y 4000 0000 0000 0002 (rechazada). Nunca se activa en la producción de Vercel
#   (VERCEL_ENV=production), aunque quede cargado ahí. Si hay NAVE_CLIENT_ID, manda Nave.
# NAVE_CLIENT_ID=
PAGOS_PRUEBA=

# Mails al cliente (Resend, https://resend.com). Todo lo que se manda o se simula queda en Ajustes → Mails y avisos.
# - MAILS_MODO=real: los mails salen de verdad a cada cliente. Cualquier otro valor (o vacío) = modo prueba: no se le manda
#   nada al cliente, se registra como "simulado".
# - RESEND_API_KEY: clave de Resend (API Keys > Create, permiso "Sending access").
# - MAIL_DOMINIO: el dominio verificado en Resend. Cada tipo de mail sale de su propia casilla (src/lib/mails/remitentes.ts).
# - MAIL_PRUEBA_A: solo en modo prueba. Casillas separadas por coma: reciben una copia de cada mail y los avisos de venta.
#   Sin dominio verificado, Resend solo deja mandar a la casilla dueña de la cuenta (remitente onboarding@resend.dev).
# - RESEND_API_KEY también activa los avisos de venta ("se vendió algo"): un mail a cada cuenta del back office (tabla admins).
# Notificaciones push de venta. Se generan una vez con `npx web-push generate-vapid-keys`; si cambian, hay que volver a activar los avisos en cada dispositivo.
# VAPID_SUBJECT: un mailto: o https: real (Apple rechaza direcciones de localhost).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

MAILS_MODO=
RESEND_API_KEY=
MAIL_DOMINIO=
MAIL_PRUEBA_A=

